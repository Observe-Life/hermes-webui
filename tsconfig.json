{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "jsx": "preserve",
    "sourceMap": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ES2023",
      "ES2024.Promise"
    ],
    "types": [
      "vite/client"
    ],
    "baseUrl": ".",
    "paths": {
      "@/store/session": [
        "src/contract/shims/session.ts"
      ],
      "@/store/windows": [
        "src/contract/shims/windows.ts"
      ],
      "@/store/boot": [
        "src/contract/shims/boot.ts"
      ],
      "@/store/notifications": [
        "src/contract/shims/notifications.ts"
      ],
      "@/i18n": [
        "src/contract/shims/i18n.ts"
      ],
      "@/hermes": [
        "src/contract/hermes.ts"
      ],
      "@hermes/shared": [
        "shared/src/index.ts"
      ],
      "@hermes/shared/skin": [
        "shared/src/skin.ts"
      ],
      "@hermes/shared/translucency": [
        "shared/src/translucency.ts"
      ],
      "@/*": [
        "src/contract/*"
      ],
      "@/store/gateway": [
        "src/contract/shims/gateway.ts"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.vue",
    "shared/**/*.ts",
    "vite.config.ts"
  ]
}